{
  "schemaVersion": 1,
  "id": "mantelcats",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {},
  "license": "${mod_license}",
  "icon": "mantelcats_icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.mantelgen.mantelcats.fabric.CopycatsImpl"
    ],
    "client": [
      "com.mantelgen.mantelcats.fabric.CopycatsClientImpl"
    ],
    "fabric-datagen": [
      "com.mantelgen.mantelcats.datagen.fabric.CCDatagenImpl"
    ],
    "jei_mod_plugin": [
      "com.mantelgen.mantelcats.compat.recipe_viewers.CopycatsJEI"
    ],
    "additional-placements-generators": [
      "com.mantelgen.mantelcats.compat.AdditionalPlacementsCompat"
    ]
  },
  "mixins": [
    "mantelcats-fabric.mixins.json",
    "mantelcats-common.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.7",
    "minecraft": ">=1.20.1",
    "create": "${create_fabric_range}"
  }
}
